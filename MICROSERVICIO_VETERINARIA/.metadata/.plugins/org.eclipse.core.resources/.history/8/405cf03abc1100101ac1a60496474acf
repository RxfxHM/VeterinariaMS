package com.mx.Responsables.Service;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.core.ParameterizedTypeReference;
import org.springframework.data.domain.Sort;
import org.springframework.data.domain.Sort.Direction;
import org.springframework.http.HttpMethod;
import org.springframework.http.ResponseEntity;
import org.springframework.stereotype.Service;
import org.springframework.web.client.RestTemplate;

import com.mx.Responsables.Entity.Responsables;
import com.mx.Responsables.Model.Mascotas;
import com.mx.Responsables.Repository.IResponsablesDao;


@Service
public class ResponsablesServiceImp implements IResponsablesService{

	
	//Inyeccion de dependencias
	@Autowired
	private IResponsablesDao dao;
	@Autowired
	private RestTemplate restTemplate;
	
	@Override
	public Responsables guardarResponsable(Responsables responsable) {
		// TODO Auto-generated method stub
		return dao.save(responsable);
	}

	@Override
	public List<Responsables> listarResponsables() {
		// TODO Auto-generated method stub
		return dao.findAll(Sort.by(Direction.ASC, "idResponsable"));
	}

	@Override
	public Responsables editarResponsable(Responsables responsable) {
		// TODO Auto-generated method stub
		return dao.save(responsable);
	}

	@Override
	public Responsables eliminarResponsables(Long idResponsable) {
		// TODO Auto-generated method stub
		Responsables aux = dao.findById(idResponsable).orElse(null);
		if(aux != null) {
			dao.delete(aux);
			return aux;
		}
		return null;
	}
	
	@Override
	public Responsables buscarResponsable(Long idResponsable) {
		// TODO Auto-generated method stub
		return dao.findById(idResponsable).orElse(null);
	}

	//Personalizado
	public List<Responsables> getByVeterinariaId(Long veterinariaId){
		return dao.findByVeterinariaId(veterinariaId);
	}

	//RESTTEMPLATE PARA SABER CUANTAS MASCOTAS TIENE DE RESPONSABLE
	public List<Mascotas> getMascotas(Long responsableId){
		ResponseEntity<List<Mascotas>> list = restTemplate.exchange("http://localhost:8003/mascotas/responsable/"+responsableId
				,HttpMethod.GET,
				null,
				new ParameterizedTypeReference<List<Mascotas>>() {
				});
		return list.getBody();
	}
	
	//Validaciones
	public boolean validarNombre(String nombre) {
		return dao.existsByNombreIgnoreCase(nombre);
	}
	
	public boolean validarVeterinariaId(Long veterinariaId) {
		return dao.existsByVeterinariaId(veterinariaId);
	}
	

}
