package com.mx.Veterinarias.Controller;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.when;

import java.util.Arrays;
import java.util.List;

import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;

import com.mx.Veterinarias.Entity.Veterinarias;
import com.mx.Veterinarias.Service.VeterinariasServiceImp;

public class VeterinariaWSTest {

	@InjectMocks //inyecta los mocks para la clase que se esta probando
	private VeterinariasWS veterinariaWS;
	
	@Mock //Crear objetos simulados a partir de mi service
	private VeterinariasServiceImp service;
	
	private Veterinarias veterinaria1;
	private Veterinarias veterinaria2;
	
	@BeforeEach //Esta anotacion indica que este metodo se ejcutara antes de cada prueba
	void setUp() {
		MockitoAnnotations.openMocks(this);
		veterinaria1 = new Veterinarias((long) 1, "Huellas", "CDMX",(long) 555555);
		veterinaria2 = new Veterinarias((long) 2, "AMIGO", "Avenida 16 de Septiembre",(long) 555555);
	}
	
	@Test
	void testGuardar() {
		when(service.guardarVeterinaria(any(Veterinarias.class))).thenReturn(veterinaria1);
		ResponseEntity<?> response = veterinariaWS.guardar(veterinaria1);
		
		assertEquals(HttpStatus.OK, response.getStatusCode());
		assertEquals(veterinaria1, response.getBody());
	}
	
	@Test
	void testListar() {
		List<Veterinarias> veterinarias = Arrays.asList(veterinaria1, veterinaria2);
		when(service.listarVeterinarias()).thenReturn(veterinarias);
		
		ResponseEntity<?> response = veterinariaWS.listar();
		
		assertEquals(HttpStatus.OK, response.getStatusCode());
		assertEquals(veterinarias, response.getBody());
	}
	
	
}
