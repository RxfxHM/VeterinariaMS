package com.mx.Mascotas.DTO;

import com.mx.Mascotas.Models.Clientes;
import com.mx.Mascotas.Models.Responsables;
import com.mx.Mascotas.Models.Veterinaria;

import lombok.Data;

@Data
public class MascotaDetalle {
	private Responsables responsable;
	private Clientes cliente;
	private Veterinaria veterinaria;
	
	public MascotaDetalle() {
	}

	public MascotaDetalle(Responsables responsable, Clientes cliente, Veterinaria veterinaria) {
		
		this.responsable = responsable;
		this.cliente = cliente;
		this.veterinaria = veterinaria;
	}
	
	

}
